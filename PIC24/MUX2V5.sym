VERSION 5
BEGIN SYMBOL MUX2V5
SYMBOLTYPE BLOCK
TIMESTAMP 2023 11 22 21 3 25
SYMPIN 0 -32 Input Sel
SYMPIN 0 -144 Input IO(3:0)
SYMPIN 0 -80 Input I1(3:0)
SYMPIN 384 -160 Output Y(3:0)
BEGIN DISPLAY 192 -200 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -32 PIN Sel ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -144 PIN IO(3:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -80 PIN I1(3:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 312 -160 PIN Y(3:0) ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
RECTANGLE N 64 -192 320 0 
RECTANGLE N 320 -172 384 -148 
LINE N 320 -160 384 -160 
LINE N 64 -32 0 -32 
RECTANGLE N 0 -92 64 -68 
LINE N 64 -80 0 -80 
RECTANGLE N 0 -156 64 -132 
LINE N 64 -144 0 -144 
END SYMBOL
