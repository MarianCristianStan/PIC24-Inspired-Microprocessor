VERSION 5
BEGIN SYMBOL PC_Update
SYMBOLTYPE BLOCK
TIMESTAMP 2024 1 7 22 49 38
SYMPIN 0 16 Input Branch
SYMPIN 0 240 Input OVF
SYMPIN 0 320 Input CF
SYMPIN 0 400 Input NF
SYMPIN 0 480 Input ZF
SYMPIN 0 160 Input PC(5:0)
SYMPIN 0 80 Input Offset(4:0)
SYMPIN 0 560 Input BranchType(2:0)
SYMPIN 384 -32 Output New_PC(5:0)
BEGIN DISPLAY 192 -148 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 16 PIN Branch ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 240 PIN OVF ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 320 PIN CF ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 400 PIN NF ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 480 PIN ZF ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 68 160 PIN PC(5:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 80 PIN Offset(4:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 560 PIN BranchType(2:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 312 -32 PIN New_PC(5:0) ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
LINE N 64 240 0 240 
LINE N 64 320 0 320 
LINE N 64 400 0 400 
LINE N 64 480 0 480 
RECTANGLE N 0 548 64 572 
LINE N 64 560 0 560 
